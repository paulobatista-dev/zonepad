pkgname=zonepad
pkgver=0.1.0
pkgrel=1
pkgdesc='Guided gamepad calibration for Linux'
arch=('any')
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer')
optdepends=('pyside6: PySide6 graphical interface')
source=("zonepad-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/zonepad-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/zonepad-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
}
